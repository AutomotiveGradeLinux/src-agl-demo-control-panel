  <property name="styleSheet">
   <string notr="true">*{
	border: none;
	background-color: transparent;
	background: none; 
	padding: 0;
	margin: 0;
	color: #fff;
}

#scrollAreaWidgetContents{
	background-color: #131313 ; /* black */
}

#centralwidget{
	background-color: #131313 ; /* black */
}

QPushButton{
	background-color: #6C6C85 ; /* pastel purple */
	padding: 5px 10px;
	border-radius: 10px;
}

QPushButton:pressed {
    background-color: #4BD7D6 ; /* light blue */
}

QSlider::groove:horizontal {
    background-color: #131313 ; /* black */
    border: 1px solid #6C6C85 ; /* pastel purple */
    height: 40px;
    border-radius: 20px;
}

QSlider::sub-page:horizontal {
    background-color: #4BD7D6 ; /* light blue */
    border: 1px solid #6C6C85 ; /* pastel purple */
    height: 36px;
    margin-right: -20px;
    border-radius: 18px;
}

QSlider::handle:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #eee, stop:1 #ccc);
    border: 1px solid #777;
    width: 28px;
    margin-top: 5px;
    margin-bottom: 5px;
	margin-left: 5px;
	margin-right: 5px;
    border-radius: 15px;
}

QSlider::groove:vertical {
    background-color: #4BD7D6 ; /* light blue */
	border: 1px solid #6C6C85 ; /* pastel purple */
    width: 40px;
    border-radius: 20px;
}

QSlider::sub-page:vertical {
    border: 1px solid #6C6C85; /* pastel purple */
    background-color: #131313; /* black */
    width: 36px;
    margin-top: 0px; /* Adjusted for better alignment */
    margin-bottom: -20px; /* Space below the sub-page */
    border-radius: 18px;
}

QSlider::handle:vertical {
    height: 28px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #eee, stop:1 #ccc);
    border: 1px solid #777;
    width: 28px;
    margin-top: 5px;
    margin-bottom: 5px;
	margin-left: 5px;
	margin-right: 5px;
    border-radius: 15px;
}

QScrollBar:horizontal {
        min-width: 240px;
        height: 13px;
    }

    QScrollBar:vertical {
        min-height: 240px;
        width: 13px;
    }

    QScrollBar::groove {
        background: 2A2827; /* dark grey */
        border-radius: 5px;
    }

    QScrollBar::handle {
        background: #4BD7D6 ; /* light blue */
        border-radius: 5px;
    }

    QScrollBar::handle:horizontal {
        width: 25px;
    }

    QScrollBar::handle:vertical {
        height: 25px; scrollAreaWidgetContents 
    }

#frame_1{
	background: #041F2B ; /* dark blue */
	border-radius: 10px;
}

QLCDNumber {
	background: #6C6C85 ; /* pastel purple */
	border-radius: 10px;
}

#gearSelector {
	background: #041F2B ; /* dark blue */
	border-radius: 10px;
}

#gearSelector QPushButton {
	border-radius: 20px;
}

#gearSelector QPushButton:checked {
    background-color: #965D62 ; /* red */
}
</string>
